  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "tsx src/app.ts",
    "dev:server1": "nodemon --watch \"src/**/*.ts\" --exec \"tsx\" src/app.ts -- --port 3000",
    "dev:server2": "nodemon --watch \"src/**/*.ts\" --exec \"tsx\" src/app.ts -- --port 3001",
    "dev:server3": "nodemon --watch \"src/**/*.ts\" --exec \"tsx\" src/app.ts -- --port 3002",
    "dev": "concurrently --names server1,server2,server3 -c \"#06f,#08e,#0ad\" --prefix \"[{name}]\" \"npm run dev:server1\" \"npm run dev:server2\" \"npm run dev:server3\"",
    "build": "npx tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.106.2",
    "@zess-online-chess/shared": "file:../shared",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "globals": "^17.6.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "redis": "^5.12.1",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "eslint": "^10.4.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}